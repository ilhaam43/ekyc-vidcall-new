# Copy through your secret manager for a Linux deployment. Do not commit real values.
NODE_ENV=production
TZ=Asia/Jakarta
POSTGRES_PASSWORD=<random-strong-secret>
JWT_SECRET=<random-strong-secret>
INTERNAL_SECRET=<random-strong-secret>
GATEWAY_SECRET=<random-strong-secret>
RECORDING_SECRET=<random-strong-secret>
JITSI_JWT_SECRET=<random-strong-secret>
JICOFO_AUTH_PASSWORD=<random-strong-secret>
JVB_AUTH_PASSWORD=<random-strong-secret>
JIBRI_RECORDER_PASSWORD=<random-strong-secret>
JIBRI_XMPP_PASSWORD=<random-strong-secret>
OBJECT_ACCESS_KEY=ekyc
OBJECT_SECRET_KEY=<random-strong-secret>
OBJECT_UI_ADMIN_EMAIL=admin@ekyc.local
OBJECT_UI_ADMIN_PASSWORD=<random-strong-secret>
KONG_CONSOLE_USERNAME=kong-admin
KONG_CONSOLE_PASSWORD=<random-strong-secret-at-least-16-characters>
KONG_CONSOLE_ORIGIN=http://127.0.0.1:5302
KONG_CONSOLE_DATA_KEY=<random-strong-key-for-encrypted-node-connections-and-snapshots>
KONG_CONSOLE_ALLOWED_NODE_ORIGINS=
KONG_CONSOLE_ALLOWED_WEBHOOK_ORIGINS=
KONG_CONSOLE_ALLOWED_IMPORT_ORIGINS=
KONG_CONSOLE_IMPORT_API_TOKEN=
KONG_CONSOLE_SMTP_URL=
KONG_CONSOLE_SMTP_FROM=
KONG_DB_PASSWORD=<random-strong-secret>
JITSI_DOMAIN=meet.example.org:9443
PUBLIC_URL=https://meet.example.org:9443
PUBLIC_ORIGIN=https://verify.example.org
JVB_ADVERTISE_IPS=<public-linux-host-ip>
# Docker Desktop local override: current host Wi-Fi/Ethernet IPv4 (update after network changes).
JVB_LOCAL_ADVERTISE_IPS=<current-local-host-ip>
CONFIG=./.local/jitsi
HTTP_PORT=80
HTTPS_PORT=9443
ENABLE_AUTH=1
AUTH_TYPE=jwt
JWT_APP_ID=ekyc
JWT_ALLOW_EMPTY=0
ENABLE_GUESTS=0
ENABLE_RECORDING=1
ENABLE_P2P=0
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
XMPP_HIDDEN_DOMAIN=recorder.meet.jitsi
XMPP_SERVER=xmpp.meet.jitsi
JIBRI_RECORDER_USER=recorder
JIBRI_XMPP_USER=jibri
JIBRI_BREWERY_MUC=jibribrewery
JITSI_IMAGE_VERSION=stable-11248
ENCRYPTION_MOCK=false
ENCRYPTION_URL=<verified-legacy-encryption-service-url>
TLS_CERT_PATH=<absolute-cert-path>
TLS_KEY_PATH=<absolute-key-path>
# Dashboard: keep Kong Admin and integration credentials server-side only.
DASHBOARD_ORIGIN=https://dashboard.example.org
DASHBOARD_MOCK_EXTERNALS=false
DASHBOARD_EXPORT_BUCKET=ekyc-dashboard-exports
KONG_ADMIN_URL=<private-kong-admin-url>
KONG_ADMIN_TOKEN=<secret-manager-value>
KONG_ADMIN_TOKEN_HEADER=Kong-Admin-Token
KONG_API_ROUTE_ID=<route-id-for-partner-api>
KONG_TRUST_CONSUMER_HEADER=false
KONG_RATE_LIMIT_POLICY=local
# For multi-node Kong, use redis policy with an appropriately secured shared Redis endpoint.
KONG_RATE_REDIS_HOST=
KONG_RATE_REDIS_PORT=6379
KONG_RATE_REDIS_DATABASE=0
KONG_RATE_REDIS_USERNAME=
KONG_RATE_REDIS_PASSWORD=
KONG_RATE_REDIS_SSL=false
ELASTICSEARCH_URL=<private-search-url>
ELASTICSEARCH_USERNAME=<secret-manager-value>
ELASTICSEARCH_PASSWORD=<secret-manager-value>
EMAIL_SERVICE_URL=<private-email-service-url>
EMAIL_SERVICE_TOKEN=<secret-manager-value>
LEGACY_DATABASE_URL=<read-only-sanitized-postgresql-copy>
# Optional embedded partner one-time provisioning inputs.
INTEGRATION_ISSUER=<partner-backend-issuer>
INTEGRATION_AUDIENCE=ekyc-integration
INTEGRATION_PUBLIC_KEY_FILE=<path-to-partner-rsa-public-key-pem>
INTEGRATION_STAFF_ORIGIN=https://staff.bank.example
INTEGRATION_AGENT_LAUNCH_URL=https://staff.bank.example/ekyc-agent/integrations/agent
INTEGRATION_CUSTOMER_ENTRY_URL=https://customer.bank.example/video-verification
